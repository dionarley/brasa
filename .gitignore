# ---------------------------------------------------------------- artefatos
# Tudo o que é derivado/gerado não entra no histórico: renders, DXF, exports,
# previews e backups. A fonte da verdade é cad/solidcraft/PS-001.sc.
/out/
/dist/
/branding/.build/
/render.png
/shot*.png

# GridCraft: site baixado, binário da CLI, cache de release e versão instalada
/tools/gridcraft/web/
/tools/gridcraft/bin/
/tools/gridcraft/.cache/
/tools/gridcraft/.version
/tools/gridcraft/.port

# Planilhas locais de trabalho (o arquivo controlado vai para o TeamCraft)
/workbooks/*.xlsx
/workbooks/*.xlsm
/workbooks/*.ods

# Visualizador DXF: dependências, build, cache e desenhos publicados
/tools/cad-viewer/node_modules/
/tools/cad-viewer/dist/
/tools/cad-viewer/.npm/
/tools/cad-viewer/drawings/
/tools/cad-viewer/.port

# Site da documentação: dependências, build, cache e cópias geradas
/site/node_modules/
/site/build/
/site/.docusaurus/
/site/.npm/
/site/static/renders/
/site/static/LICENSE

# Backups manuais do SolidCraft (o git já guarda o histórico)
cad/solidcraft/*.bak
cad/solidcraft/*_backup.sc
cad/solidcraft/.~*.lock
cad/solidcraft/*.step
cad/solidcraft/parts/*.step
cad/solidcraft/*.3mf

# ------------------------------------------------- referências de terceiros
# Fotos de anúncios, artigos e PDFs têm direitos de terceiros e NÃO são
# redistribuídos neste repositório (ver LEGAL.md, seção 3).
/ref/
/docs/*.pdf
/docs/extracted/

# ------------------------------------------------------------------- lixo
*.tmp
*.log
.DS_Store
__pycache__/
*.pyc

# Travas do LibreOffice
.~lock.*#

# Exportações avulsas de CAD (derivadas; a fonte é o .sc) e trava do OpenCADStudio
*.dxf
.xdp-*.ocs.lock-*
